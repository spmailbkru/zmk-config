#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
              &kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5     &kp NUMBER_6    &kp N7     &kp N8         &kp N9      &kp NUMBER_0  &kp MINUS  &kp EQUAL
&kp LEFT_WIN  &kp ESCAPE      &kp Q         &kp W         &kp E         &kp R      &kp T           &kp Y      &kp U          &kp I       &kp O         &kp P      &kp LBKT         &kp RIGHT_BRACKET
              &kp TAB         &kp A         &kp S         &kp D         &kp F      &kp G           &kp H      &kp J          &kp K       &kp L         &kp SEMI   &mt RCTRL SQT
              &kp LEFT_SHIFT  &kp Z         &kp X         &kp C         &kp V      &kp B           &kp N      &kp M          &kp COMMA   &kp DOT       &kp FSLH   &kp RIGHT_SHIFT
                                            &mo 2         &mo 1         &kp LCTRL  &kp RET         &kp SPACE  &kp BACKSPACE  &kp DELETE  &kp LEFT_ALT
            >;
        };

        lower_layer {
            bindings = <
              &kp F1  &kp F2     &kp F3      &kp F4     &kp F5         &kp F6       &kp F7      &kp F8          &kp F9          &kp F10          &kp F11        &kp F12
&kp CAPSLOCK  &trans  &none      &none       &none      &none          &kp GRAVE    &kp INSERT  &kp HOME        &kp UP_ARROW    &kp PAGE_UP      &none          &none    &none
              &trans  &none      &kp DELETE  &kp SPACE  &kp BACKSPACE  &none        &none       &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &none          &none
              &trans  &kp LC(Z)  &kp LC(X)   &kp LC(C)  &kp LC(V)      &kp LC(B)    &none       &kp END         &kp DOWN_ARROW  &kp PAGE_DOWN    &kp BACKSLASH  &trans
                                 &trans      &trans     &trans         &trans       &trans      &trans          &trans          &trans
            >;
        };

        raise_layer {
            bindings = <
        &trans           &trans        &trans     &trans            &trans             &trans        &trans        &trans    &trans     &trans     &trans           &trans
&trans  &kp KP_NUM       &kp KP_SLASH  &kp KP_N7  &kp KP_N8         &kp KP_N9          &none         &kp C_VOL_UP  &kp HOME  &kp PSCRN  &kp PG_UP  &kp SLCK         &kp CAPS         &trans
        &mt LCTRL EQUAL  &none         &kp DEL    &kp SPACE         &kp BACKSPACE      &none         &kp C_MUTE    &kp LEFT  &kp UP     &kp RIGHT  &kp INS          &mt RCTRL K_APP
        &trans           &kp KP_N0     &kp KP_N1  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp KP_DOT    &kp C_VOL_DN  &kp END   &kp DOWN   &kp PG_DN  &kp PAUSE_BREAK  &trans
                                       &trans     &trans            &trans             &lt 0 RET     &lt 0 ESC     &trans    &trans     &trans
            >;
        };
    };
};
